# Copy this file to .env and adjust if needed. .env itself is gitignored and
# must never be committed — these are local development values only.

# URL the RUNNING APPLICATION uses. Should be the restricted ledger_api login
# (see README > Security hardening). Falls back to a built-in dev default
# (owner login, port 5433) if unset, UNLESS APP_ENV=production.
DATABASE_URL=postgresql://ledger_api:ledger_api_dev_password@localhost:5433/ledger

# URL used only by `python -m app.db.migrate`. Needs owner privileges, so it
# is kept separate from the application's restricted login. Falls back to
# DATABASE_URL if unset — but that's the restricted login, which CANNOT run
# migrations, so set this explicitly for local development.
MIGRATION_DATABASE_URL=postgresql://ledger:ledger_dev_password@localhost:5433/ledger

# Set to "production" to make the app refuse to start without an explicit
# DATABASE_URL, instead of silently falling back to a development default.
# Leave unset for local development.
APP_ENV=development

# Used only by the test suite (tests/conftest.py). A dedicated database that
# the test fixtures are allowed to drop and rebuild.
TEST_DATABASE_URL=postgresql://ledger:ledger_dev_password@localhost:5433/ledger_test